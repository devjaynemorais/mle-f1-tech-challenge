# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# IDEs / Editores
.vscode/
.idea/
*.swp
*.swo

# Ambientes Virtuais
venv/
.venv/
env/
.env

# Jupyter Notebooks
.ipynb_checkpoints/

# Dados (Ignorando conteudo, mas nao o .gitkeep)
/data/*
!/data/.gitkeep
!/data/raw/
!/data/interim/
!/data/processed/
!/data/external/
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/external/*
!/data/external/.gitkeep
*.csv
*.tsv
*.xlsx
*.dat
*.parquet
*.feather
*.h5
*.hdf5

# Modelos (Ignorando conteudo, mas nao o .gitkeep)
/models/*
!/models/.gitkeep
*.pkl
*.pt
*.pth
*.joblib

# Logs, Metricas e Experimentos
logs/
*.log
mlruns/
mlartifacts/
*.db
wandb/
artifacts/

# Sistema Operacional
.DS_Store
Thumbs.db
*.egg-info/
*.egg

# Claude Code (configuracoes locais)
.claude/settings.local.json
