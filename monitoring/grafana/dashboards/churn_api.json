{
  "uid": "churn-api",
  "title": "Churn API — Monitoramento",
  "tags": ["churn", "mlops"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Requisições / segundo",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_request_duration_seconds_count[1m])) by (handler)",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 }
      }
    },
    {
      "id": 2,
      "title": "Taxa de erros 5xx",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{status!~\"2xx\"}[1m]))",
          "legendFormat": "5xx/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      }
    },
    {
      "id": 3,
      "title": "Latência (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 }
      }
    },
    {
      "id": 4,
      "title": "Predições realizadas (total)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(churn_predictions_total)",
          "legendFormat": "Predições"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0 }
      }
    },
    {
      "id": 5,
      "title": "Predições por modelo (acumulado)",
      "type": "piechart",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(churn_predictions_total) by (model)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Distribuição da probabilidade de churn",
      "type": "bargauge",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(increase(churn_probability_bucket[1h])) by (le)",
          "legendFormat": "le={{le}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0 }
      }
    }
  ]
}
